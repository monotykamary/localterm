{
  "name": "@monotykamary/localterm-monorepo",
  "version": "1.35.4",
  "private": true,
  "workspaces": [
    "apps/*",
    "apps/harness/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/fix-node-pty.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "start": "node packages/cli/bin/localterm.mjs restart",
    "stop": "node packages/cli/bin/localterm.mjs stop",
    "cli": "node packages/cli/bin/localterm.mjs",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=2",
    "test:e2e": "turbo run test:e2e --concurrency=2",
    "typecheck": "turbo run typecheck",
    "lint": "node scripts/lint.mjs",
    "lint:fix": "node scripts/lint.mjs --fix",
    "lint:dead": "knip",
    "lint:range": "fr",
    "doctor:react": "react-doctor --yes --no-telemetry --verbose",
    "doctor:react:changed": "react-doctor --yes --no-telemetry --scope lines --base main --include-untracked --no-dead-code --no-supply-chain",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "bun run format:check && bun run lint && bun run lint:range && bun run typecheck",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@chenglou/freerange": "^0.0.4",
    "@types/node": "^26.2.0",
    "@voidzero-dev/vite-plus-core": "^0.2.8",
    "knip": "^6.32.0",
    "portless": "^0.15.5",
    "react-doctor": "^0.9.10",
    "turbo": "^2.10.9",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.8"
  },
  "overrides": {
    "@fontsource/geist-mono": "5.2.7",
    "@voidzero-dev/vite-plus-core": "^0.2.8",
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.2.8"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "^1.4.0"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "patchedDependencies": {
    "@xterm/addon-image@0.10.0-beta.287": "patches/@xterm__addon-image@0.10.0-beta.287.patch",
    "@xterm/addon-webgl@0.20.0-beta.290": "patches/@xterm__addon-webgl@0.20.0-beta.290.patch",
    "node-pty@1.1.0": "patches/node-pty@1.1.0.patch"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@google/genai",
    "esbuild",
    "node-pty",
    "protobufjs",
    "sharp",
    "spawn-sync",
    "unrs-resolver"
  ]
}
