diff --git a/src/unix/scoped-fd.h b/src/unix/scoped-fd.h
new file mode 100644
index 0000000..b2371db
--- /dev/null
+++ b/src/unix/scoped-fd.h
@@ -0,0 +1,22 @@
+#pragma once
+
+// Each native descriptor has one owner, including failed-spawn paths.
+class PtyScopedFd {
+ public:
+  explicit PtyScopedFd(int fd = -1) : fd_(fd) {}
+  ~PtyScopedFd() { reset(); }
+  PtyScopedFd(const PtyScopedFd&) = delete;
+  PtyScopedFd& operator=(const PtyScopedFd&) = delete;
+  int get() const { return fd_; }
+  int release() {
+    int fd = fd_;
+    fd_ = -1;
+    return fd;
+  }
+  void reset(int fd = -1) {
+    if (fd_ >= 0) close(fd_);
+    fd_ = fd;
+  }
+ private:
+  int fd_;
+};
