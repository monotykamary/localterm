diff --git a/src/unix/darwin-spawn.h b/src/unix/darwin-spawn.h
new file mode 100644
index 0000000..243fd7a
--- /dev/null
+++ b/src/unix/darwin-spawn.h
@@ -0,0 +1,74 @@
+#pragma once
+#include "scoped-fd.h"
+
+static void
+pty_posix_spawn(char** argv, char** env,
+                const struct termios *termp,
+                const struct winsize *winp,
+                int* master, pid_t* pid, int* err) {
+  *master = -1;
+  *pid = -1;
+  *err = [&]() -> int {
+    // Reserve missing stdio slots without consuming extra PTYs. The last
+    // open can be above stderr; it must be closed too (even at index zero).
+    PtyScopedFd low_fds[3];
+    for (auto& fd : low_fds) {
+      fd.reset(open("/dev/null", O_RDWR));
+      if (fd.get() == -1) return errno;
+      if (fd.get() > STDERR_FILENO) break;
+    }
+
+    PtyScopedFd master_fd(posix_openpt(O_RDWR));
+    if (master_fd.get() == -1) return errno;
+    if (grantpt(master_fd.get()) == -1 || unlockpt(master_fd.get()) == -1) return errno;
+
+    // ptsname() uses shared storage; TIOCPTYGNAME is thread-safe.
+    char slave_name[128];
+    if (ioctl(master_fd.get(), TIOCPTYGNAME, slave_name) == -1) return errno;
+    PtyScopedFd slave_fd(open(slave_name, O_RDWR | O_NOCTTY));
+    if (slave_fd.get() == -1) return errno;
+    if (termp && tcsetattr(slave_fd.get(), TCSANOW, termp) == -1) return errno;
+    if (winp && ioctl(slave_fd.get(), TIOCSWINSZ, winp) == -1) return errno;
+
+    posix_spawn_file_actions_t acts;
+    int result = posix_spawn_file_actions_init(&acts);
+    if (result != 0) return result;
+    posix_spawnattr_t attrs;
+    result = posix_spawnattr_init(&attrs);
+    if (result != 0) {
+      posix_spawn_file_actions_destroy(&acts);
+      return result;
+    }
+
+    result = [&]() -> int {
+      int error;
+      for (int target = STDIN_FILENO; target <= STDERR_FILENO; ++target) {
+        error = posix_spawn_file_actions_adddup2(&acts, slave_fd.get(), target);
+        if (error != 0) return error;
+      }
+      error = posix_spawn_file_actions_addclose(&acts, slave_fd.get());
+      if (error != 0) return error;
+      error = posix_spawn_file_actions_addclose(&acts, master_fd.get());
+      if (error != 0) return error;
+      error = posix_spawnattr_setflags(&attrs, POSIX_SPAWN_CLOEXEC_DEFAULT |
+          POSIX_SPAWN_SETSIGDEF | POSIX_SPAWN_SETSIGMASK | POSIX_SPAWN_SETSID);
+      if (error != 0) return error;
+      sigset_t signals;
+      sigfillset(&signals);
+      error = posix_spawnattr_setsigdefault(&attrs, &signals);
+      if (error != 0) return error;
+      sigemptyset(&signals);
+      error = posix_spawnattr_setsigmask(&attrs, &signals);
+      if (error != 0) return error;
+      do {
+        error = posix_spawn(pid, argv[0], &acts, &attrs, argv, env);
+      } while (error == EINTR);
+      return error;
+    }();
+
+    posix_spawnattr_destroy(&attrs);
+    posix_spawn_file_actions_destroy(&acts);
+    if (result == 0) *master = master_fd.release();
+    return result;
+  }();
+}
